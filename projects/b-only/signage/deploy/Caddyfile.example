# Proposition à intégrer via une PR du dépôt Serveur après validation.
# Aucune installation ni modification DNS n'est effectuée par ce fichier.
# Node doit rester lié à 127.0.0.1:8787, inaccessible depuis Internet.
conference.b-only.org, accueil.b-only.org, workshop.b-only.org {
    @admin path /admin /admin/* /admin.js /api/admin /api/admin/*
    respond @admin 404
    reverse_proxy 127.0.0.1:8787
}

adminvideo.b-only.org {
    # Accessible sur Internet. Node exige SIGNAGE_ADMIN_HOSTS et le mot de passe.
    reverse_proxy 127.0.0.1:8787
}
